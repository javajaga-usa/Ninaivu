__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.test-deps/
*.db
*.db-wal
*.db-shm
.DS_Store
.ai-models/
.ninaivu-control/
# The Tamil font the Windows build fetches (installers/windows/build.ps1).
ninaivu/static/fonts/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
.env
.env.*
!.env.example
*.log
Thumbs.db

# Private keys and certificates: Ninaivu's own certificate authority and
# server certificate (tls/ in the state folder), a signing key exported here
# to build with. A state folder made in the checkout (--state-dir .ninaivu)
# holds the keys, the accounts and the setup code.
*.pem
*.key
*.pfx
*.p12
*.crt
tls/
.ninaivu/

# Scratch output from ad-hoc audit/test runs pointed at a repo-local
# basetemp instead of the system temp dir -- these should never be tracked.
.audit-*-tmp/
.audit-tools/
.date-tests*/
.upload-tests*/
audit-test-output.txt

# Playwright, for the browser tests in tests/*.mjs. Installed per machine
# ("npm install --no-save playwright" and "npx playwright install chromium"),
# never committed -- it is a few hundred megabytes of browser.
node_modules/

# Installer build output (installers/windows/build.ps1, installers/macos/build.sh)
installers/windows/wheels/
installers/windows/pynsist_pkgs/
installers/windows/tcl/
installers/windows/installer.built.cfg
site-build/

# Generated on each Mac by Setup Ninaivu, with this checkout's paths in it
*.app/
installers/linux/build/
