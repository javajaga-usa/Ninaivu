# =============================================================================
# Ninaivu — environment configuration
# Copy this file to .env and customize values for your deployment
# =============================================================================

# --- Storage & Directories ---
# Primary media folder to index
NINAIVU_ROOT=/data/media

# Additional allowed media folders (comma-separated if multiple)
# NINAIVU_ROOTS=/data/media,/mnt/storage/archives

# Host path for docker-compose media bind mount
MEDIA_DIR=./photos

# Persistent application state directory (index.db, thumbnails, TLS CA)
NINAIVU_STATE_DIR=/data/state

# --- Network & Server Binding ---
# 0.0.0.0 serves the entire local network; 127.0.0.1 restricts to localhost
NINAIVU_HOST=0.0.0.0

# Family application port (default: 5000)
NINAIVU_PORT=5000

# Admin management console port (default: 3000)
NINAIVU_ADMIN_PORT=3000

# Confine folder selection to configured roots (recommended for public/WAN servers)
NINAIVU_LOCK_ROOTS=0

# Let visitors view public media without credentials (1) or enforce sign-in (0)
NINAIVU_OPEN_BROWSING=1

# Network name announcement via mDNS (ninaivu.local)
NINAIVU_NAME=ninaivu
NINAIVU_MDNS=1

# --- Scanning & Processing Engine ---
# Number of worker threads for background media scanning (default: CPU cores, max 8)
NINAIVU_WORKERS=4

# Watch library for real-time filesystem events
NINAIVU_WATCH=1

# Minimum size (in bytes) to be considered real media (skips icons/sprites, default: 60KB)
NINAIVU_MIN_MEDIA_BYTES=61440

# Automatically determine orientation for untagged photos (scans, messaging app exports)
NINAIVU_DETECT_ORIENTATION=1

# Use CLIP embeddings to assist orientation scoring on ambiguous images (0=off, 1=on)
NINAIVU_ORIENTATION_AI=0

# Screen explicit content behind an admin filter toggle
NINAIVU_NSFW_FILTER=1

# --- AI & Semantic Search ---
# Engine tier: auto | clip | light | off
# auto  = uses OpenCLIP if PyTorch is installed, else falls back to light
# clip  = enables natural language search & visual similarity (~350MB model)
# light = metadata, color, and aspect-ratio tagging without PyTorch
# off   = no AI indexing
NINAIVU_AI_ENGINE=auto

# Optional Hugging Face token if OpenCLIP download requires authentication
# HF_TOKEN=hf_your_personal_access_token

# --- Cloud Backup (Google Drive) ---
# Enable one-way cloud backup service
NINAIVU_CLOUD_ENABLED=0

# Include hidden/admin-only items in cloud backup (default: 0)
NINAIVU_CLOUD_INCLUDE_HIDDEN=0

# Target folder name in Google Drive
NINAIVU_CLOUD_FOLDER_NAME=Ninaivu

# Automatically start cloud upload worker on boot
NINAIVU_CLOUD_AUTOSTART=0

# Upload bandwidth ceiling in KB/s (0 = unlimited)
NINAIVU_CLOUD_RATE_KBPS=0

# Permitted upload window (local time HH:MM). Leave empty for 24/7
# NINAIVU_CLOUD_WINDOW_START=23:00
# NINAIVU_CLOUD_WINDOW_END=06:00

# Where the automatic index backups go (names, albums, visibility, edits).
# Defaults to <state dir>/backups — the same drive as the index. Put it on
# another drive so a disk failure does not take the backups with it.
# NINAIVU_BACKUP_DIR=/mnt/other-disk/ninaivu-backups
# How many backups to keep
NINAIVU_BACKUP_KEEP=7
