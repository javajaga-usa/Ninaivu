# =============================================================================
# Ninaivu — Docker settings
# Copy this file to .env beside docker-compose.yml and set MEDIA_DIR.
#
# Only *where things are* belongs here: folders and ports. How Ninaivu
# behaves — who may browse, what the scan works out, backup — is chosen in
# the console, and a NINAIVU_* value for one of those only fills in what the
# console has not been used to choose (it never undoes a choice made there).
# =============================================================================

# The folder on this computer that holds the photographs (mounted read-write
# at /data/media inside the container).
MEDIA_DIR=./photos

# Where Ninaivu keeps its index, thumbnails and settings inside the container.
NINAIVU_STATE_DIR=/data/state

# The family app's port inside the container (docker-compose.yml publishes it).
NINAIVU_PORT=5000

# The console's port inside the container. docker-compose.yml publishes it on
# 127.0.0.1 only; the first administrator made from outside the container
# asks for the setup code printed in `docker logs ninaivu`.
NINAIVU_ADMIN_PORT=3000

# More library folders, separated by colons (mount them in docker-compose.yml).
# NINAIVU_ROOTS=/data/media:/data/archive

# Where the automatic copies of the index go. Put them on another disk so a
# disk failure does not take the copies with it.
# NINAIVU_BACKUP_DIR=/data/backups

# Where downloaded AI models are kept.
# NINAIVU_AI_MODELS_DIR=/data/state/models

# A Hugging Face token, only if a model download asks for one.
# HF_TOKEN=
