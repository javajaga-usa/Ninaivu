#!/bin/sh
# Ninaivu, portable, for Linux: the one program at the top of the folder.
#
#   ./ninaivu                    opens the Ninaivu Control Panel
#   ./ninaivu --tray             the small menu in the system tray instead
#   ./ninaivu --server [PHOTOS]  the server alone, in this terminal (a machine
#                                with no desktop, or over ssh)
#   ./ninaivu --where            says where it keeps everything, and ends
#   ./ninaivu --bring FOLDER     brings the library of the older Ninaivu in
#                                FOLDER into this one (what the Control Panel
#                                offers, for a machine with no desktop)
#   ./ninaivu --go-back          gives it back to that older Ninaivu
#
# The program and its own Python are in app/. New Linux installations keep
# their index, settings, models and panel files in ~/.ninaivu. Existing
# app-local .ninaivu/ or data/ libraries retain their location. An explicit
# NINAIVU_STATE_DIR takes precedence. Logs stay beside the program in logs/.
# Replacing the program folder does not remove a home-folder library.
set -e

# The folder this script is in, wherever it was started from, through a
# symbolic link to it too (~/bin/ninaivu → here).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
root=$(cd "$(dirname "$self")" && pwd -P)
app="$root/app"
python="$app/python/bin/python3"

say() {
    echo "Ninaivu: $1" >&2
    # A person who double-clicked this in a file manager has no terminal to
    # read it in. NINAIVU_NO_DIALOG for a script or a test.
    if [ -z "${NINAIVU_NO_DIALOG:-}" ] && [ ! -t 2 ] && command -v zenity >/dev/null 2>&1; then
        zenity --error --title=Ninaivu --text="$1" 2>/dev/null || true
    fi
}

if [ ! -x "$python" ]; then
    say "Ninaivu's program files were not found next to this script ($app). Extract the whole archive and run ninaivu from the folder it makes."
    exit 1
fi
data="${NINAIVU_STATE_DIR:-$HOME/.ninaivu}"
# Keep an existing app-local library when no explicit location was supplied.
if [ -z "${NINAIVU_STATE_DIR:-}" ]; then
    for previous in "$root/.ninaivu" "$root/data"; do
        if [ -f "$previous/index.db" ] || [ -f "$previous/index-location.json" ]; then
            data="$previous"
            break
        fi
    done
fi
if ! mkdir -p "$root/logs" "$data/control" "$data/ai-models" 2>/dev/null || [ ! -w "$data" ]; then
    say "Ninaivu cannot write to the folder it is in ($root). Move the whole folder somewhere you can write to, such as your home folder, and run it there."
    exit 1
fi

# What makes this the portable build: where Ninaivu keeps the files beside
# itself, its index and settings, the AI models and its logs. The same four
# the Windows Ninaivu.exe and the Mac app's portable mode set.
export NINAIVU_HOME="$data/control"
export NINAIVU_STATE_DIR="$data"
export NINAIVU_AI_MODELS_DIR="$data/ai-models"
export NINAIVU_LOG_DIR="$root/logs"
export NINAIVU_PORTABLE=1
export NINAIVU_PORTABLE_ROOT="$root"
export NINAIVU_PROGRAM_DIR="$app"
export NINAIVU_PYTHON="$python"
export NINAIVU_LAUNCHER="$root/ninaivu"
# The private Python must not be steered by another one's settings.
unset PYTHONHOME PYTHONPATH
# Nor packages somebody installed for themselves with pip --user (~/.local):
# the folder's own are the ones it was built with.
export PYTHONNOUSERSITE=1

case "${1:-}" in
    --where)
        printf 'NINAIVU_HOME=%s\nNINAIVU_STATE_DIR=%s\nNINAIVU_AI_MODELS_DIR=%s\nNINAIVU_LOG_DIR=%s\nNINAIVU_PYTHON=%s\n' \
            "$NINAIVU_HOME" "$NINAIVU_STATE_DIR" "$NINAIVU_AI_MODELS_DIR" "$NINAIVU_LOG_DIR" "$NINAIVU_PYTHON"
        exit 0 ;;
    --autostart) shift; exec "$python" -m ninaivu.desktop.autostart --start "$@" ;;
    --tray) shift; exec "$python" -m ninaivu.desktop.tray "$@" ;;
    --server) shift; exec "$python" -m ninaivu "$@" ;;
    --bring|--go-back) exec "$python" -m ninaivu.desktop.portable "$@" ;;
    --add-to-menu) exec "$python" -m ninaivu.desktop.linux_menu --add ;;
    --remove-from-menu) exec "$python" -m ninaivu.desktop.linux_menu --remove ;;
esac
exec "$python" -m ninaivu.desktop.app "$@"
